;; cbor.core — definite-length CBOR (RFC 8949) encode/decode.
;;
;; Across a kotoba/IPLD codebase CBOR keeps getting hand-rolled — the CACAO leash
;; issuer, the apqc/kabuto/isco coordinators each open-code the major-type headers.
;; This is that once, with two encoders:
;;
;;   (encode x)          — canonical/deterministic: map keys sorted dag-cbor style
;;                         (shorter key first, then bytewise) → stable bytes for IPLD
;;   (encode-ordered ps) — a map from an ORDERED [k v] seq, keys emitted as given
;;                         (CAIP-122 CACAO and other insertion-order-sensitive wire
;;                         formats need this — canonical sorting would corrupt them)
;;
;;   (decode bytes)      — → Clojure data (maps as {}, arrays as [], text as String,
;;                         byte strings as bytes, ints as Long/number, bool/nil)
;;
;; Supported major types: 0 uint · 1 negint · 2 byte-string · 3 text · 4 array ·
;; 5 map · 6 tag (as an explicit `Tagged` wrapper — see below) · 7
;; (false/true/null/finite float64). No indefinite lengths. Floats are always
;; emitted as IEEE-754 binary64: DAG-CBOR has one canonical float width and
;; excludes NaN and infinities from the IPLD Data Model.
;;
;;   (tagged 42 bytes)   — encodes as major type 6, tag `n`, then the wrapped
;;                         value; decodes back to a `Tagged`. Plain data never
;;                         silently becomes a tag and a tag never silently
;;                         becomes plain data — the wrapper is always explicit,
;;                         so canonical bytes stay unambiguous. IPLD's CID link
;;                         (tag 42) is layered on top by `kotoba-lang/ipld`;
;;                         this namespace stays codec-generic.
;;
;; PORTABLE and PURE (adr-2609242330 S1, 2026-09-24): the encoder builds a
;; vector of ints and the decoder threads a position; only the leaves listed
;; under "the byte plumbing" below differ per host. `encode`/`decode`'s public
;; contract (bytes in, bytes/Clojure-data out) is unchanged: byte-array on
;; :clj, Uint8Array on :cljs, and a vector of ints 0..255 in Kotoba.
(ns cbor.core
  {:kotoba/export [OrderedMap Tagged decode encode encode-ordered ordered tag-number tag-value tagged tagged?]}
  )

;; An order-preserving map (vs. a Clojure map, which `encode` canonical-sorts).
;; Nestable: an OrderedMap value inside another OrderedMap keeps its own order —
;; what CAIP-122 CACAO needs (the {h,p,s} envelope AND p's 8 fields are ordered).
;;
;; `defrecord`, not `deftype`: a bare `deftype` with no protocol impl uses JVM
;; identity equality (two OrderedMaps with the same pairs are NOT `=`), and
;; adding one via `#?@(:clj [Object ...] :cljs [IEquiv ...])` (the shape
;; `Tagged` below used to need) doesn't even work on nbb -- SCI's `deftype`
;; support does not dispatch a custom implementation of a BUILT-IN cljs.core
;; protocol (`IEquiv`/`IHash`) on a deftype, `extend-type` included (confirmed
;; empirically: `Protocol not found: IEquiv` either way, in total isolation
;; from this file). `defrecord` sidesteps this entirely -- structural
;; equality/hash are part of what the compiler generates for a record on
;; EVERY platform (JVM/self-hosted cljs/nbb's SCI), not a protocol extension
;; nbb has to resolve at all. No existing caller relied on OrderedMap's old
;; identity-equality default (only `encode`/`decode` round-trip bytes are
;; ever asserted on), so this is a strict gain, not a behavior change.
(defrecord OrderedMap [pairs])
(defn ordered
  "Wrap an ordered seq of [k v] pairs as a map whose key order `encode` preserves."
  [pairs] (OrderedMap. pairs))

;; A CBOR tag (major type 6): tag number `n` wrapping `value`. Encoded as the
;; tag head followed by the encoded `value`; `decode` reconstructs the wrapper.
;; Field access goes through `tag-number`/`tag-value` (NOT `:n`/`:value` map-
;; keyword access, unlike `OrderedMap` above -- kept as narrow accessor fns so
;; a future caller never has to know or care that a record is a map under the
;; hood). Same `defrecord`-not-`deftype` reasoning as `OrderedMap`'s comment:
;; structural equality/hash come for free on every platform including nbb,
;; instead of a hand-written `#?@(:clj [Object ...] :cljs [IEquiv ...])`
;; protocol block that nbb's SCI can't dispatch (confirmed empirically)."
(defrecord Tagged [n value])

(defn tagged
  "Wrap `value` in CBOR tag `n` (major type 6). `n` is a non-negative integer."
  [n value]
  (Tagged. n value))

(defn tagged? [x] (instance? Tagged x))
(defn tag-number [t] (:n t))
(defn tag-value [t] (:value t))

;; ── the byte plumbing (adr-2609242330 S1) ────────────────────────────────────
;; The encoder and decoder are PURE: the output is a vector of ints 0..255
;; built by `conj`/`into`, the input is read by position, and the cursor is
;; a value threaded through the reads (`[value pos]`), not a mutable object.
;; What is left per host is a handful of LEAVES, each with a `:default` that
;; is a real Kotoba body -- never a copy of the :cljs host code, which the
;; compiler refused by name (adr-2609242330 §2):
;;
;;   leaf               :clj / :cljs (speed)           :default (Kotoba)
;;   str->bytes         getBytes / TextEncoder          string-code-point-at walk
;;   float64-bytes      ByteBuffer / DataView           f64-to-bits + u64-shift-right
;;   bytes->float64     ByteBuffer / DataView           i64-shift-left + f64-from-bits
;;   finite-number?     isFinite                        exponent bits of f64-to-bits
;;   in-count/in-byte/  alength / aget / .slice         count / nth / subvec
;;   in-slice
;;   write-input-bytes  by index / one chunk             conj loop
;;   write-text         (str->bytes) / one chunk        str->bytes + into
;;   out->bytes         byte-array / Uint8Array         the vector itself
;;   bytes->str         String. / TextDecoder (fatal)   string-from-utf8
;;   bytes-like?        bytes? / Uint8Array|Int8Array   document-kind = :bytes
;;
;; The host branches must answer exactly what the `:default` answers: the
;; golden corpus (test/cbor/golden.edn, written by the pre-S1 host encoder)
;; pins the bytes, and scripts/verify-pure-leaves.cljk evaluates each
;; `:default` body on nbb against its host twin.
;;
;; The last two leaves had NO `:default` until 2026-09-25, on purpose, so the
;; compiler reported them as `function body is empty` instead of a guessed
;; body; each waited on a language decision, and both are now made (kotoba-lang
;; lang/guest-grammar.edn `:bytes-value`, superproject adr-2609242330):
;;   * bytes->str -- `(string-from-utf8 b)` is the language's string
;;     constructor. It takes the language's byte string, `:bytes`, so the
;;     vector of ints this file builds is converted with
;;     `bytes-from-vector-i64` (which refuses an item outside [0,255] rather
;;     than masking it). Canonical UTF-8 only: invalid text is REFUSED with a
;;     named trap (utf8/overlong, utf8/surrogate, ...), never replaced with
;;     U+FFFD -- so the host branches decode fatally too and throw
;;     "cbor: invalid UTF-8 text" (they used to replace, the one place the
;;     three hosts could decode one input to three different strings).
;;   * bytes-like? -- a byte string is the `:bytes` TYPE, distinct from
;;     `:vector-i64` in every checker; a value whose type is only known at run
;;     time is a `:document`, and a document is a byte string when its kind is
;;     `:bytes`. No document carries a bytes node yet (that is the next wall:
;;     encode-into's dispatch over dynamic values), so today this answers false
;;     for every document -- which is true: none of them is a byte string.

(defn- out->bytes
  "The encoder's output as the host's byte container. On :cljs an element
  of V is either one byte or a whole Uint8Array/Int8Array chunk appended by
  `write-input-bytes` / `write-text` (copied here once, with `.set`, which
  converts an Int8Array's -1 to 255 as the old masking push did)."
  [v]
  #?(:clj (byte-array (map unchecked-byte v))
     :cljs (let [n (reduce (fn [n x] (+ n (if (number? x) 1 (.-length x)))) 0 v)
                 a (js/Uint8Array. n)]
             (reduce (fn [pos x]
                       (if (number? x)
                         (do (aset a pos x) (inc pos))
                         (do (.set a (if (instance? js/Int8Array x) (js/Uint8Array. (.-buffer x) (.-byteOffset x) (.-length x)) x) pos)
                             (+ pos (.-length x)))))
                     0 v)
             a)
     :default v))

(defn- in-count [data]
  #?(:clj (alength ^bytes data)
     :cljs (.-length data)
     :default (count data)))

(defn- in-byte
  "The unsigned byte at POS (an Int8Array / JVM byte[] is signed)."
  [data pos]
  #?(:clj (bit-and (aget ^bytes data (int pos)) 0xff)
     :cljs (bit-and (aget data pos) 0xff)
     :default (bit-and (nth data pos) 0xff)))

(defn- in-slice
  "Bytes [FROM, TO) of DATA as a fresh container of DATA's own kind."
  [data from to]
  #?(:clj (java.util.Arrays/copyOfRange ^bytes data (int from) (int to))
     :cljs (.slice data from to)
     :default (subvec data from to)))

(defn- utf8-code-point
  "OUT with the UTF-8 encoding of code point CP appended (CP is a scalar
  value: never a surrogate half)."
  [out cp]
  (cond
    (< cp 0x80) (conj out cp)
    (< cp 0x800) (conj out (+ 0xC0 (quot cp 64)) (+ 0x80 (bit-and cp 0x3F)))
    (< cp 0x10000) (conj out (+ 0xE0 (quot cp 4096))
                         (+ 0x80 (bit-and (quot cp 64) 0x3F))
                         (+ 0x80 (bit-and cp 0x3F)))
    :else (conj out (+ 0xF0 (quot cp 262144))
                (+ 0x80 (bit-and (quot cp 4096) 0x3F))
                (+ 0x80 (bit-and (quot cp 64) 0x3F))
                (+ 0x80 (bit-and cp 0x3F)))))

(defn- utf8-width
  "Bytes of the UTF-8 sequence that starts with a code point CP."
  [cp]
  (cond (< cp 0x80) 1 (< cp 0x800) 2 (< cp 0x10000) 3 :else 4))

(defn- str->bytes
  "The UTF-8 bytes of S as a vector of ints. On the hosts a lone surrogate
  becomes U+FFFD (TextEncoder; the JDK's getBytes writes `?` instead -- the
  one pre-existing host divergence, unchanged here). A Kotoba string is
  UTF-8 already and cannot hold a lone surrogate."
  [s]
  #?(:clj (mapv #(bit-and % 0xff) (.getBytes ^String s "UTF-8"))
     :cljs (let [a (.encode (js/TextEncoder.) s)
                 n (.-length a)]
             (loop [i 0 out (transient [])]
               (if (< i n)
                 (recur (inc i) (conj! out (aget a i)))
                 (persistent! out))))
     :default (let [n (string-byte-length s)]
                (loop [i 0 out []]
                  (if (< i n)
                    (let [cp (string-code-point-at s i)]
                      (recur (+ i (utf8-width cp)) (utf8-code-point out cp)))
                    out)))))

(defn- bytes->str [b]
  #?(:clj (try (str (.decode (doto (.newDecoder java.nio.charset.StandardCharsets/UTF_8)
                                (.onMalformedInput java.nio.charset.CodingErrorAction/REPORT)
                                (.onUnmappableCharacter java.nio.charset.CodingErrorAction/REPORT))
                              (java.nio.ByteBuffer/wrap ^bytes b)))
               (catch java.nio.charset.CharacterCodingException _
                 (throw (ex-info "cbor: invalid UTF-8 text" {}))))
     :cljs (try (.decode (js/TextDecoder. "utf-8" #js {:fatal true}) b)
                (catch :default _ (throw (ex-info "cbor: invalid UTF-8 text" {}))))
     :default (string-from-utf8 (bytes-from-vector-i64 b))))

(defn- finite-number? [x]
  #?(:clj (and (number? x) (Double/isFinite (double x)))
     :cljs (and (number? x) (js/Number.isFinite x))
     ;; IEEE-754: exponent field all ones is Inf or NaN.
     :default (and (number? x)
                   (not= 2047 (bit-and (u64-shift-right (f64-to-bits x) 52) 2047)))))

(defn- float64-bytes
  "The 8 big-endian bytes of the binary64 X, as a vector of ints."
  [x]
  #?(:clj (let [b (-> (java.nio.ByteBuffer/allocate 8) (.putDouble (double x)) .array)]
            (mapv #(bit-and % 0xff) b))
     :cljs (let [buffer (js/ArrayBuffer. 8)
                 view (js/DataView. buffer)]
             (.setFloat64 view 0 x false)
             (loop [i 0 out []]
               (if (< i 8) (recur (inc i) (conj out (.getUint8 view i))) out)))
     :default (let [bits (f64-to-bits x)]
                (loop [s 56 out []]
                  (if (< s 0)
                    out
                    (recur (- s 8) (conj out (bit-and (u64-shift-right bits s) 255))))))))

(defn- bytes->float64
  "The binary64 whose big-endian bytes are the 8-byte container B."
  [b]
  #?(:clj (.getDouble (java.nio.ByteBuffer/wrap ^bytes b))
     :cljs (.getFloat64 (js/DataView. (.-buffer b) (.-byteOffset b) (.-byteLength b))
                        0 false)
     :default (f64-from-bits
               (loop [i 0 acc 0]
                 (if (< i 8)
                   (recur (inc i) (bit-or (i64-shift-left acc 8) (in-byte b i)))
                   acc)))))

(defn- bytes-like? [x]
  #?(:clj (bytes? x)
     :cljs (or (instance? js/Uint8Array x) (instance? js/Int8Array x))
     :default (= (document-kind x) :bytes)))

;; `byte-at` extracts the byte at bit-position `s` (a multiple of 8) from a
;; non-negative `n`. Division by a power of two, then the low 8 bits: exact
;; on every host. JS bitwise operators coerce to Int32 first, so a shift of
;; an n above 2^32 would truncate it before shifting; `quot` by 2^s does
;; not (a double divides by a power of two exactly), and `bit-and 255`
;; after it only needs the low bits, which ToInt32 keeps. On the JVM and in
;; Kotoba n is an i64 and `quot` is the logical shift for n >= 0.
(def ^:private byte-weights
  {0 1 8 256 16 65536 24 16777216 32 4294967296 40 1099511627776
   48 281474976710656 56 72057594037927936})

(defn- byte-at [n s]
  (bit-and (quot n (get byte-weights s)) 255))

;; ── encode ────────────────────────────────────────────────────────────────────
(defn- write-head [out major n]
  (let [mt (* major 32)]
    (cond
      ;; bit-or / bit-and 0xff, not +: a caller-supplied tag number that is
      ;; negative or fractional lands here, and the pre-S1 byte sink masked
      ;; every byte it was handed -- the bytes stay what they were.
      (< n 24)          (conj out (bit-and (bit-or mt n) 0xff))
      (< n 0x100)       (conj out (+ mt 24) (bit-and n 0xff))
      (< n 0x10000)     (conj out (+ mt 25) (byte-at n 8) (byte-at n 0))
      (< n 0x100000000) (conj out (+ mt 26) (byte-at n 24) (byte-at n 16)
                              (byte-at n 8) (byte-at n 0))
      :else             (conj out (+ mt 27) (byte-at n 56) (byte-at n 48)
                              (byte-at n 40) (byte-at n 32) (byte-at n 24)
                              (byte-at n 16) (byte-at n 8) (byte-at n 0)))))

(defn- write-input-bytes
  "OUT with every byte of the host byte container B appended. On :cljs the
  container is appended as ONE element and copied by `out->bytes` (a 1 MiB
  byte string was 10x slower on nbb one interpreted conj per byte); the JVM
  appends by index; Kotoba appends each byte (no host container there)."
  [out b]
  #?(:clj (persistent! (areduce ^bytes b i acc (transient out) (conj! acc (bit-and (aget ^bytes b i) 0xff))))
     :cljs (conj out b)
     :default (let [n (in-count b)]
                (loop [i 0 out out]
                  (if (< i n) (recur (inc i) (conj out (in-byte b i))) out)))))

(declare encode-into)

(defn- key-bytes [k]
  (str->bytes (cond (string? k) k (keyword? k) (name k) :else (str k))))

(defn- key-bytes<
  "dag-cbor key order over encoded keys: shorter first, then bytewise."
  [ka kb]
  (let [la (count ka) lb (count kb)]
    (if (not= la lb)
      (< la lb)
      (loop [i 0]
        (cond (= i la) false
              (not= (nth ka i) (nth kb i)) (< (nth ka i) (nth kb i))
              :else (recur (inc i)))))))

(defn- encode-pairs [out pairs]
  (loop [ps (seq pairs) out (write-head out 5 (count pairs))]
    (if ps
      (let [[k v] (first ps)]
        (recur (next ps) (encode-into (encode-into out (if (keyword? k) (name k) k)) v)))
      out)))

(defn- sort-dag-cbor
  "The [k v] entries of map M in dag-cbor key order. Each key is encoded
  once, not once per comparison; ties keep `seq` order (a stable sort),
  as the per-comparison form did."
  [m]
  (->> (seq m)
       (map (fn [e] [(key-bytes (key e)) e]))
       (sort-by first key-bytes<)
       (map second)))

(defn- write-text [out s]
  #?(:cljs (let [u (.encode (js/TextEncoder.) s)]
             (conj (write-head out 3 (.-length u)) u))
     :default (let [b (str->bytes s)]
                (into (write-head out 3 (count b)) b))))

(defn- encode-into [out x]
  (cond
    (nil? x)            (conj out 0xf6)
    (true? x)           (conj out 0xf5)
    (false? x)          (conj out 0xf4)
    (integer? x)        (if (neg? x) (write-head out 1 (- -1 x)) (write-head out 0 x))
    (number? x)         (if (finite-number? x)
                          (into (conj out 0xfb) (float64-bytes x))
                          (throw (ex-info "cbor: non-finite float unsupported"
                                          {:value x})))
    (string? x)         (write-text out x)
    (keyword? x)        (write-text out (name x))
    (bytes-like? x)     (write-input-bytes (write-head out 2 (in-count x)) x)
    (instance? Tagged x) (encode-into (write-head out 6 (tag-number x)) (tag-value x))
    (instance? OrderedMap x) (encode-pairs out (:pairs x))
    (map? x)            (encode-pairs out (sort-dag-cbor x))
    (sequential? x)     (reduce encode-into (write-head out 4 (count x)) x)
    :else (throw (ex-info "cbor: unsupported type" {:type (type x) :value x}))))

(defn encode
  "Deterministic CBOR bytes for Clojure data. Map keys are sorted dag-cbor style."
  [x]
  (out->bytes (encode-into [] x)))

(defn encode-ordered
  "CBOR-encode a MAP given as an ordered seq of [k v] pairs — keys emitted in the
   given order (NOT sorted). For CAIP-122 CACAO and other order-sensitive formats."
  [pairs]
  (out->bytes (encode-pairs [] pairs)))

;; ── decode ────────────────────────────────────────────────────────────────────
;; Every reader takes the input and a position and answers [value next-pos].
;; A big-endian multi-byte integer is rebuilt by arithmetic (+ (* acc 256)
;; byte), NOT bit-or/bit-shift-left -- the JS 32-bit truncation `byte-at`
;; avoids applies here too. Exact up to 2^53 on the hosts.

(defn- eof! []
  (throw (ex-info "cbor: unexpected end of input" {})))

(defn- read-byte [data pos]
  (if (< pos (in-count data)) (in-byte data pos) (eof!)))

(defn- read-n [data pos cnt]
  (loop [i 0 acc 0]
    (if (< i cnt) (recur (inc i) (+ (* acc 256) (read-byte data (+ pos i)))) [acc (+ pos cnt)])))

(defn- read-arg [data pos info]
  (cond (< info 24) [info pos]
        (= info 24) [(read-byte data pos) (inc pos)]
        (= info 25) (read-n data pos 2)
        (= info 26) (read-n data pos 4)
        (= info 27) (read-n data pos 8)
        :else (throw (ex-info "cbor: indefinite/reserved length unsupported" {:info info}))))

(defn- read-bytes
  "N bytes at POS. A short input throws rather than answering fewer bytes: a
  truncated byte/text string must fail like every other truncated shape, not
  decode into something wholly unlike the original."
  [data pos n]
  (when (> (+ pos n) (in-count data)) (eof!))
  [(in-slice data pos (+ pos n)) (+ pos n)])

(declare decode-from)

(defn- decode-items [data pos n]
  (loop [k 0 pos pos acc []]
    (if (< k n)
      (let [[v pos] (decode-from data pos)] (recur (inc k) pos (conj acc v)))
      [acc pos])))

(defn- decode-entries [data pos n]
  (loop [k 0 pos pos acc {}]
    (if (< k n)
      (let [[key pos] (decode-from data pos)
            [v pos] (decode-from data pos)]
        (recur (inc k) pos (assoc acc key v)))
      [acc pos])))

(defn- decode-from [data pos]
  (let [ib (read-byte data pos)
        pos (inc pos)
        major (quot ib 32)
        info (bit-and ib 0x1f)]
    (case major
      0 (read-arg data pos info)
      1 (let [[n pos] (read-arg data pos info)] [(- -1 n) pos])
      2 (let [[n pos] (read-arg data pos info)] (read-bytes data pos n))
      3 (let [[n pos] (read-arg data pos info)
              [b pos] (read-bytes data pos n)]
          [(bytes->str b) pos])
      4 (let [[n pos] (read-arg data pos info)] (decode-items data pos n))
      5 (let [[n pos] (read-arg data pos info)] (decode-entries data pos n))
      6 (let [[n pos] (read-arg data pos info)
              [v pos] (decode-from data pos)]
          [(Tagged. n v) pos])
      7 (case info
          20 [false pos]
          21 [true pos]
          22 [nil pos]
          27 (let [[b pos] (read-bytes data pos 8)
                   value (bytes->float64 b)]
               (when-not (finite-number? value)
                 (throw (ex-info "cbor: non-finite float unsupported"
                                 {:value value})))
               [value pos])
          (throw (ex-info "cbor: unsupported simple/float" {:info info})))
      (throw (ex-info "cbor: unsupported major type" {:major major})))))

(defn decode
  "Decode exactly one CBOR value. Maps → {}, arrays → [], text → String,
   byte-strings → bytes (byte-array on :clj, a slice of the input's own kind
   on :cljs, a vector of ints in Kotoba), ints and finite float64 → numbers,
   true/false/null. Trailing bytes are rejected."
  [b]
  (let [[value pos] (decode-from b 0)]
    (when (< pos (in-count b))
      (throw (ex-info "cbor: trailing bytes after top-level value" {})))
    value))
